{
  "version": 2,
  "start": "npm run dev -- --hostname 0.0.0.0 --port 4173",
  "port": 4173,
  "install": [
    {
      "name": "Node.js dependencies",
      "check": "test -d node_modules",
      "run": "npm ci"
    },
    {
      "name": "SQLite database schema",
      "check": "node -e \"const D=require('better-sqlite3');const d=new D('clinic.db',{readonly:true,fileMustExist:true});const c=d.pragma('table_info(consultations)');d.close();process.exit(c.some(x=>x.name==='clinic_name')?0:1)\"",
      "run": "npm run db:migrate"
    }
  ],
  "services": []
}
